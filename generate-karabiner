#!/usr/bin/env python3
"""Generate karabiner.json using only the Python standard library."""

from __future__ import annotations

import difflib
import json
import os
import re
import sys
from pathlib import Path
from typing import Any, Iterable


HERE = Path(__file__).resolve().parent
OUT = HERE / "karabiner.json"
PROFILE_NAME = "Linux"
TERMINAL_BUNDLE_ID = os.environ.get("TERMINAL_BUNDLE_ID", "com.googlecode.iterm2")

TERMINALS = [
    r"^com\.googlecode\.iterm2$", r"^com\.apple\.Terminal$",
    r"^com\.mitchellh\.ghostty$", r"^com\.github\.wez\.wezterm$",
    r"^com\.alacritty$", r"^io\.alacritty$",
    r"^net\.kovidgoyal\.kitty$", r"^co\.zeit\.hyper$",
]
EDITORS = [r"^com\.microsoft\.VSCode", r"^com\.vscodium$"]
BROWSERS = [
    r"^com\.google\.Chrome$", r"^com\.google\.Chrome\.beta$",
    r"^com\.google\.chrome$", r"^org\.mozilla\.firefox$",
    r"^org\.mozilla\.nightly$", r"^com\.brave\.Browser$",
    r"^com\.apple\.Safari$",
]
SUBLIME = [r"^com\.sublimetext\.[0-9]+$"]


def condition(kind: str, bundle_ids: Iterable[str]) -> list[dict[str, Any]]:
    return [{"type": kind, "bundle_identifiers": list(bundle_ids)}]


IF_TERM = condition("frontmost_application_if", TERMINALS)
IF_BROWSER = condition("frontmost_application_if", BROWSERS)
IF_DOCUMENT_APPS = condition("frontmost_application_if", BROWSERS + SUBLIME)
UNLESS_TERM_EDITOR = condition("frontmost_application_unless", TERMINALS + EDITORS)
UNLESS_TERM = condition("frontmost_application_unless", TERMINALS)
ANYWHERE: list[dict[str, Any]] = []


def mods(value: str) -> list[str]:
    return value.split("+") if value else []


def man(from_key: str, from_mods: str, to_key: str, to_mods: str,
        conditions: list[dict[str, Any]]) -> dict[str, Any]:
    source: dict[str, Any] = {"key_code": from_key}
    if from_mods:
        source["modifiers"] = {"mandatory": mods(from_mods)}
    target: dict[str, Any] = {"key_code": to_key}
    if to_mods:
        target["modifiers"] = mods(to_mods)
    result: dict[str, Any] = {"type": "basic"}
    if conditions:
        result["conditions"] = conditions
    result.update({"from": source, "to": [target]})
    return result


def shell_man(from_key: str, from_mods: str, command: str,
              conditions: list[dict[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {"type": "basic"}
    if conditions:
        result["conditions"] = conditions
    result.update({
        "from": {"key_code": from_key, "modifiers": {"mandatory": mods(from_mods)}},
        "to": [{"shell_command": command}],
    })
    return result


def escape_man(from_key: str, from_mods: str, following_key: str,
               conditions: list[dict[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {"type": "basic"}
    if conditions:
        result["conditions"] = conditions
    result.update({
        "from": {"key_code": from_key, "modifiers": {"mandatory": mods(from_mods)}},
        "to": [{"key_code": "escape"}, {"key_code": following_key}],
    })
    return result


def forward_delete_man(from_key: str, from_mods: str,
                       conditions: list[dict[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {"type": "basic"}
    if conditions:
        result["conditions"] = conditions
    result.update({
        "from": {"key_code": from_key, "modifiers": {"mandatory": mods(from_mods)}},
        "to": [
            {"key_code": "escape"}, {"key_code": "open_bracket"},
            {"key_code": "3"},
            {"key_code": "grave_accent_and_tilde", "modifiers": ["left_shift"]},
        ],
    })
    return result


def build() -> dict[str, Any]:
    if not re.fullmatch(r"[A-Za-z0-9.-]+", TERMINAL_BUNDLE_ID):
        raise ValueError(f"invalid TERMINAL_BUNDLE_ID: {TERMINAL_BUNDLE_ID}")

    rules: list[dict[str, Any]] = []
    def rule(description: str, *manipulators: dict[str, Any]) -> None:
        rules.append({"description": description, "manipulators": list(manipulators)})

    controls = [
        ("c", "interrupt"), ("z", "suspend"), ("d", "delete character / EOF"),
        ("l", "clear screen"), ("y", "yank killed text"),
        ("g", "cancel current input"), ("t", "transpose characters"),
        ("p", "previous history entry"), ("n", "next history entry"),
        ("b", "move one character left"), ("f", "move one character right"),
        ("v", "insert next key literally"), ("h", "delete previous character"),
        ("q", "resume terminal output"), ("s", "pause terminal output"),
        ("o", "execute history entry and load next"), ("a", "start of line"),
        ("e", "end of line"), ("u", "kill before cursor"),
        ("k", "kill after cursor"), ("w", "delete word back"),
        ("r", "reverse history search"), ("i", "horizontal tab / completion"),
        ("j", "line feed / application command"), ("m", "carriage return / accept"),
        ("x", "application prefix / Nano exit"),
    ]
    if "".join(sorted(key for key, _ in controls)) != "abcdefghijklmnopqrstuvwxyz":
        raise ValueError("terminal control-character table must contain a-z exactly once")
    for key, meaning in controls:
        rule(f"terminal: [1]+{key.upper()} sends ^{key.upper()} ({meaning})",
             man(key, "command", key, "left_control", IF_TERM))

    rule("terminal: [1]+Shift+6 sends ^^ (Pico selection)",
         man("6", "command+shift", "6", "left_control+left_shift", IF_TERM))
    rule("terminal: [1]+Fn+Backspace deletes the next word",
         escape_man("delete_or_backspace", "command+fn", "d", IF_TERM))
    rule("terminal: Fn+Backspace sends Forward Delete",
         forward_delete_man("delete_or_backspace", "fn", IF_TERM))
    rule("terminal: [1]+Backspace deletes the previous word",
         man("delete_or_backspace", "command", "w", "left_control", IF_TERM))
    rule("terminal: [1]+Shift+C copies",
         man("c", "command+shift", "c", "left_command", IF_TERM))
    rule("terminal: [1]+Shift+V pastes",
         man("v", "command+shift", "v", "left_command", IF_TERM))
    rule("terminal: [1]+arrows for history search and word movement",
         *(man(key, "command", key, "left_control", IF_TERM)
           for key in ("up_arrow", "down_arrow", "left_arrow", "right_arrow")))
    rule("terminal: Fn+Left/Right moves to the start/end of the command line",
         man("left_arrow", "fn", "a", "left_control", IF_TERM),
         man("right_arrow", "fn", "e", "left_control", IF_TERM))
    rule("terminal: Shift+Fn+Left/Right scrolls to the top/bottom",
         man("left_arrow", "fn+shift", "home", "left_command", IF_TERM),
         man("right_arrow", "fn+shift", "end", "left_command", IF_TERM))
    rule("terminal: [1]+Tab / [1]+Shift+Tab cycles tabs",
         man("tab", "command", "close_bracket", "left_command+left_shift", IF_TERM),
         man("tab", "command+shift", "open_bracket", "left_command+left_shift", IF_TERM))
    rule("terminal: [1]+Shift+T opens a new tab",
         man("t", "command+shift", "t", "left_command", IF_TERM))
    rule("terminal: [1]+Shift+Q quits the terminal application",
         man("q", "command+shift", "q", "left_command", IF_TERM))
    rule("terminal: [3]/[4]+1..9 jumps to a tab",
         *(man(str(n), "option", str(n), "left_command", IF_TERM) for n in range(1, 10)))

    rule("editing: [1]+arrows move by word",
         man("left_arrow", "command", "left_arrow", "left_option", UNLESS_TERM_EDITOR),
         man("right_arrow", "command", "right_arrow", "left_option", UNLESS_TERM_EDITOR))
    rule("editing: [1]+Shift+arrows select by word",
         man("left_arrow", "command+shift", "left_arrow", "left_option+left_shift", UNLESS_TERM_EDITOR),
         man("right_arrow", "command+shift", "right_arrow", "left_option+left_shift", UNLESS_TERM_EDITOR))
    rule("editing: [1]+Fn+Backspace deletes the next word in browsers",
         man("delete_or_backspace", "command+fn", "delete_forward", "left_option", IF_BROWSER))
    rule("editing: [1]+Backspace / [1]+Del delete a word",
         man("delete_or_backspace", "command", "delete_or_backspace", "left_option", UNLESS_TERM_EDITOR),
         man("delete_forward", "command", "delete_forward", "left_option", UNLESS_TERM_EDITOR))
    rule("editing: [1]+Fn+Left/Right moves to the document start/end in browsers and Sublime",
         man("left_arrow", "command+fn", "up_arrow", "left_command", IF_DOCUMENT_APPS),
         man("right_arrow", "command+fn", "down_arrow", "left_command", IF_DOCUMENT_APPS),
         man("left_arrow", "command+fn+shift", "up_arrow", "left_command+left_shift", IF_DOCUMENT_APPS),
         man("right_arrow", "command+fn+shift", "down_arrow", "left_command+left_shift", IF_DOCUMENT_APPS))
    rule("editing: [1]+Tab / [1]+Shift+Tab cycles tabs",
         man("tab", "command", "tab", "left_control", UNLESS_TERM),
         man("tab", "command+shift", "tab", "left_control+left_shift", UNLESS_TERM))

    rule("window: [3]/[4]+Tab switches applications",
         man("tab", "option", "tab", "left_command", ANYWHERE),
         man("tab", "option+shift", "tab", "left_command+left_shift", ANYWHERE))
    rule("window: [3]/[4]+Backtick cycles windows of the current application",
         man("grave_accent_and_tilde", "option", "grave_accent_and_tilde", "left_command", ANYWHERE),
         man("grave_accent_and_tilde", "option+shift", "grave_accent_and_tilde", "left_command+left_shift", ANYWHERE))
    rule("window: [3]/[4]+F4 closes the current tab/window",
         man("f4", "option", "w", "left_command", ANYWHERE))
    rule("window: [2]/[5]+L locks the screen",
         man("l", "control", "q", "left_control+left_command", ANYWHERE))
    rule("window: [1]+[3]/[4]+T opens the configured terminal",
         shell_man("t", "command+option", f"open -b {TERMINAL_BUNDLE_ID}", ANYWHERE))
    rule("fkeys: Fn+F1 opens the Help menu",
         man("f1", "fn", "slash", "left_command+left_shift", UNLESS_TERM_EDITOR))
    rule("fkeys: Fn+F3 finds next",
         man("f3", "fn", "g", "left_command", UNLESS_TERM_EDITOR))
    rule("fkeys: Fn+F5 reloads the page",
         man("f5", "fn", "r", "left_command", IF_BROWSER))

    simple = [
        ("left_control", "left_command"), ("left_option", "left_control"),
        ("left_command", "left_option"), ("right_command", "right_option"),
        ("right_option", "right_control"),
    ]
    return {"profiles": [
        {"name": "Default", "virtual_hid_keyboard": {"keyboard_type_v2": "ansi"}},
        {
            "name": PROFILE_NAME, "selected": True,
            "virtual_hid_keyboard": {"keyboard_type_v2": "ansi"},
            "simple_modifications": [
                {"from": {"key_code": source}, "to": [{"key_code": target}]}
                for source, target in simple
            ],
            "complex_modifications": {"rules": rules},
        },
    ]}


def main() -> int:
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] != "--check"):
        print(f"usage: {Path(sys.argv[0]).name} [--check]", file=sys.stderr)
        return 2
    try:
        generated = build()
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    if len(sys.argv) == 2:
        try:
            current = json.loads(OUT.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            print(f"karabiner.json cannot be checked: {error}", file=sys.stderr)
            return 1
        if current == generated:
            print("karabiner.json is up to date")
            return 0
        print("karabiner.json is OUT OF DATE -- run ./generate-karabiner", file=sys.stderr)
        before = json.dumps(current, indent=2, sort_keys=True).splitlines()
        after = json.dumps(generated, indent=2, sort_keys=True).splitlines()
        for line in list(difflib.unified_diff(before, after, fromfile="current", tofile="generated"))[:40]:
            print(line, file=sys.stderr)
        return 1
    OUT.write_text(json.dumps(generated, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    profile = generated["profiles"][1]
    rules = profile["complex_modifications"]["rules"]
    manipulators = sum(len(item["manipulators"]) for item in rules)
    print(f"wrote {OUT}")
    print(f'  {len(profile["simple_modifications"])} modifier mappings')
    print(f"  {len(rules)} rules, {manipulators} manipulators")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
