// Place your key bindings in this file to override the defaults
//
// Physical key positions, matching a PC/Linux keyboard:
//   [1] corner key       -> Command   (the Linux "Ctrl" role)
//   [2] middle key       -> Control   (real Control lives here)
//   [3] next to spacebar -> Option    (the Linux "Alt" role)
//   [4] right of spacebar -> Option   (the second Linux "Alt" position)
//   [5] rightmost         -> Control  (the second Linux "Super" position)
// That positional remapping is done in Karabiner-Elements (simple_modifications).
//
// Karabiner handles the [1]-key translation for every other app but NOT VS Code:
// it only knows which app is frontmost, not whether focus is in the editor or the
// integrated terminal. Those need opposite behaviour for the same keys -- [1]+C
// must copy in the editor and interrupt in the terminal -- so VS Code is excluded
// from the Karabiner rules and handled here, where "when" clauses distinguish them.
[
  // ---- TERMINAL: control characters back onto [1], Linux-style ----
  { "key": "cmd+c", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" }, "when": "terminalFocus" },   // SIGINT
  { "key": "cmd+z", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" }, "when": "terminalFocus" },   // suspend
  { "key": "cmd+a", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" }, "when": "terminalFocus" },   // start of line
  { "key": "cmd+e", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0005" }, "when": "terminalFocus" },   // end of line
  { "key": "cmd+u", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" }, "when": "terminalFocus" },   // kill before cursor
  { "key": "cmd+k", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000b" }, "when": "terminalFocus" },   // kill after cursor
  { "key": "cmd+w", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" }, "when": "terminalFocus" },   // delete word back
  { "key": "cmd+r", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" }, "when": "terminalFocus" },   // reverse history search
  { "key": "cmd+d", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0004" }, "when": "terminalFocus" },   // delete character / EOF
  { "key": "cmd+l", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" }, "when": "terminalFocus" },   // clear screen
  { "key": "cmd+y", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0019" }, "when": "terminalFocus" },   // yank killed text
  { "key": "cmd+g", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" }, "when": "terminalFocus" },   // cancel current input
  { "key": "cmd+t", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0014" }, "when": "terminalFocus" },   // transpose characters
  { "key": "cmd+p", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" }, "when": "terminalFocus" },   // previous history entry
  { "key": "cmd+n", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" }, "when": "terminalFocus" },   // next history entry
  { "key": "cmd+b", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" }, "when": "terminalFocus" },   // move one character left
  { "key": "cmd+f", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" }, "when": "terminalFocus" },   // move one character right
  { "key": "cmd+v", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" }, "when": "terminalFocus" },   // insert next key literally
  { "key": "cmd+h", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0008" }, "when": "terminalFocus" },   // delete previous character
  { "key": "cmd+q", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0011" }, "when": "terminalFocus" },   // resume terminal output
  { "key": "cmd+s", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0013" }, "when": "terminalFocus" },   // pause terminal output
  { "key": "cmd+o", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000f" }, "when": "terminalFocus" },   // execute history entry and load next
  { "key": "cmd+i", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0009" }, "when": "terminalFocus" },   // horizontal tab / completion
  { "key": "cmd+j", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000a" }, "when": "terminalFocus" },   // line feed / application command
  { "key": "cmd+m", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000d" }, "when": "terminalFocus" },   // carriage return / accept
  { "key": "cmd+x", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0018" }, "when": "terminalFocus" },   // application prefix / Nano exit
  { "key": "cmd+shift+6", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001e" }, "when": "terminalFocus" },   // Pico: start/clear text selection (^^)
  { "key": "cmd+backspace", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" }, "when": "terminalFocus" },   // delete word back
  { "key": "cmd+delete", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001bd" }, "when": "terminalFocus" }, // delete word forward

  // ---- TERMINAL: arrows -> the escape sequences your .zshrc binds ----
  { "key": "cmd+up", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5A" }, "when": "terminalFocus" },   // history-beginning-search-backward
  { "key": "cmd+down", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5B" }, "when": "terminalFocus" },   // history-beginning-search-forward
  { "key": "cmd+right", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5C" }, "when": "terminalFocus" },   // forward-word
  { "key": "cmd+left", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5D" }, "when": "terminalFocus" },   // backward-word

  // ---- TERMINAL: Linux copy/paste, since plain [1]+C stays SIGINT ----
  { "key": "cmd+shift+c", "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected" },
  { "key": "cmd+shift+v", "command": "workbench.action.terminal.paste",
    "when": "terminalFocus" },

  // ---- EDITOR: word-wise movement/deletion on [1]+arrows (items 1-4) ----
  // Replaces the macOS meanings of Cmd+arrows (line start/end) and Cmd+Backspace
  // (delete to line start). Linux uses Home/End, which is fn+Left/Right here.
  { "key": "cmd+left", "command": "cursorWordLeft", "when": "editorTextFocus" },
  { "key": "cmd+right", "command": "cursorWordRight", "when": "editorTextFocus" },
  { "key": "cmd+shift+left", "command": "cursorWordLeftSelect", "when": "editorTextFocus" },
  { "key": "cmd+shift+right", "command": "cursorWordRightSelect", "when": "editorTextFocus" },
  { "key": "cmd+backspace", "command": "deleteWordLeft", "when": "editorTextFocus && !editorReadonly" },
  { "key": "cmd+delete", "command": "deleteWordRight", "when": "editorTextFocus && !editorReadonly" },

  // ---- EDITOR: compact-keyboard Ctrl+Home/End on [1]+fn+Left/Right ----
  { "key": "cmd+home", "command": "cursorTop", "when": "editorTextFocus" },
  { "key": "cmd+end", "command": "cursorBottom", "when": "editorTextFocus" },
  { "key": "cmd+shift+home", "command": "cursorTopSelect", "when": "editorTextFocus" },
  { "key": "cmd+shift+end", "command": "cursorBottomSelect", "when": "editorTextFocus" }
]
